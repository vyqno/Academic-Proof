[
  {
    "type": "function",
    "name": "requestCredential",
    "inputs": [
      { "name": "student", "type": "address" },
      { "name": "universityId", "type": "uint256" },
      { "name": "degreeType", "type": "uint8" },
      { "name": "major", "type": "string" },
      { "name": "gpa", "type": "uint16" },
      { "name": "honors", "type": "uint8" },
      { "name": "graduationDate", "type": "uint256" },
      { "name": "metadataURI", "type": "string" }
    ],
    "outputs": [{ "name": "credentialId", "type": "uint256" }],
    "stateMutability": "nonpayable"
  },
  {
    "type": "function",
    "name": "signCredential",
    "inputs": [{ "name": "credentialId", "type": "uint256" }],
    "outputs": [],
    "stateMutability": "nonpayable"
  },
  {
    "type": "function",
    "name": "revokeCredential",
    "inputs": [
      { "name": "credentialId", "type": "uint256" },
      { "name": "reason", "type": "string" }
    ],
    "outputs": [],
    "stateMutability": "nonpayable"
  },
  {
    "type": "function",
    "name": "getCredential",
    "inputs": [{ "name": "credentialId", "type": "uint256" }],
    "outputs": [
      {
        "name": "credential",
        "type": "tuple",
        "components": [
          { "name": "student", "type": "address" },
          { "name": "universityId", "type": "uint256" },
          { "name": "degreeType", "type": "uint8" },
          { "name": "major", "type": "string" },
          { "name": "gpa", "type": "uint16" },
          { "name": "honors", "type": "uint8" },
          { "name": "graduationDate", "type": "uint256" },
          { "name": "issuanceDate", "type": "uint256" },
          { "name": "metadataURI", "type": "string" },
          { "name": "isRevoked", "type": "bool" }
        ]
      }
    ],
    "stateMutability": "view"
  },
  {
    "type": "function",
    "name": "getStudentCredentials",
    "inputs": [{ "name": "student", "type": "address" }],
    "outputs": [{ "name": "credentialIds", "type": "uint256[]" }],
    "stateMutability": "view"
  },
  {
    "type": "function",
    "name": "getApprovalStatus",
    "inputs": [{ "name": "credentialId", "type": "uint256" }],
    "outputs": [
      { "name": "signatureCount", "type": "uint256" },
      { "name": "requiredSignatures", "type": "uint256" },
      { "name": "issued", "type": "bool" }
    ],
    "stateMutability": "view"
  },
  {
    "type": "function",
    "name": "getTotalCredentials",
    "inputs": [],
    "outputs": [{ "name": "count", "type": "uint256" }],
    "stateMutability": "view"
  },
  {
    "type": "event",
    "name": "CredentialIssued",
    "inputs": [
      { "name": "credentialId", "type": "uint256", "indexed": true },
      { "name": "student", "type": "address", "indexed": true },
      { "name": "universityId", "type": "uint256", "indexed": true },
      { "name": "degreeType", "type": "uint8", "indexed": false }
    ]
  }
]
