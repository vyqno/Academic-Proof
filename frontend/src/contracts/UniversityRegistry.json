    "outputs": [
      {
        "name": "university",
        "type": "tuple",
        "components": [
          { "name": "admin", "type": "address" },
          { "name": "name", "type": "string" },
          { "name": "country", "type": "string" },
          { "name": "metadataURI", "type": "string" },
          { "name": "isActive", "type": "bool" },
          { "name": "requiredSigners", "type": "uint256" },
          { "name": "registeredAt", "type": "uint256" }
        ]
      }
