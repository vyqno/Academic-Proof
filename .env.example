# ================================================================
# Network Configuration
# ================================================================

# Sepolia Testnet
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
ETHERSCAN_API_KEY=your_etherscan_api_key

# Anvil Local Network
ANVIL_RPC_URL=http://127.0.0.1:8545

# Private Keys (NEVER commit real keys!)
PRIVATE_KEY=your_private_key_here
ANVIL_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ================================================================
# Deployed Contract Addresses (Update after deployment)
# ================================================================

REGISTRY_ADDRESS=
CREDENTIAL_ADDRESS=
VERIFIER_ADDRESS=

# ================================================================
# University Registration
# ================================================================

UNI_ADMIN=0x...
UNI_NAME=Massachusetts Institute of Technology
UNI_COUNTRY=USA
UNI_METADATA_URI=ipfs://QmXXXXX...
SIGNER_1=0x...
SIGNER_2=0x...
REQUIRED_SIGNERS=2

# ================================================================
# Credential Issuance
# ================================================================

STUDENT_ADDRESS=0x...
UNIVERSITY_ID=1

# Degree Types: 0=ASSOCIATE, 1=BACHELOR, 2=MASTER, 3=DOCTORATE, 4=CERTIFICATE, 5=DIPLOMA
DEGREE_TYPE=1

MAJOR=Computer Science

# GPA (multiply by 100, e.g., 3.85 = 385)
GPA=385

# Honors: 0=NONE, 1=CUM_LAUDE, 2=MAGNA_CUM_LAUDE, 3=SUMMA_CUM_LAUDE, 4=WITH_DISTINCTION, 5=WITH_HIGH_DISTINCTION
HONORS=2

# Unix timestamp
GRADUATION_DATE=1704067200

METADATA_URI=ipfs://QmYYYYY...

# ================================================================
# Credential Operations
# ================================================================

CREDENTIAL_ID=1
REVOKE_REASON=Academic misconduct detected

